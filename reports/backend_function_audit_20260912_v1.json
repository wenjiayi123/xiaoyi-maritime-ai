  "fixes": [
    {
      "id": "task-step-failure-retry",
      "trigger": "POST /api/tasks/{id}/next encounters an upstream source exception",
      "before": "The step was marked completed before the source call; retry could report 100% with remaining steps unexecuted.",
      "after": "The source call completes before task state changes; failure leaves the original running step and progress available for retry.",
      "regression": "test_failed_task_step_can_be_retried_without_skipping_work"
    },
    {
      "id": "rl-zero-config",
      "trigger": "Train with seed=0, discount_factor=0, epsilon_end=0",
      "before": "Truthiness defaults silently replaced valid zero inputs.",
      "after": "Configured zeros are preserved in the run receipt, saved config, trained Q-learning model and evaluation.",
      "regression": "test_zero_training_parameters_reach_real_model_and_saved_evidence"
    },
    {
      "id": "rl-cancel-validation",
      "trigger": "Cancel after learning has finished while validation is still running",
      "before": "The API returned cancelling but the completion callback later replaced it with trained.",
      "after": "The completion callback checks cancellation under the job lock and preserves the cancelled terminal state; test evaluation returns 409.",
      "regression": "test_training_cancel_during_validation_remains_cancelled"
    }
  ],
