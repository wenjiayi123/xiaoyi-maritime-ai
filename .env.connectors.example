# 小懿港口连接器安全配置模板
#
# 安全默认值：全部 offline、地址和凭据为空、写权限关闭。
# 本文件可以提交；真实凭据文件不得提交到版本库。
# 应用从进程环境变量读取这些值，不会自动加载本文件。

# TOS - Terminal Operating System
XIAOYI_CONNECTOR_TOS_MODE=offline
XIAOYI_CONNECTOR_TOS_BASE_URL=
XIAOYI_CONNECTOR_TOS_AUTH_TYPE=none
XIAOYI_CONNECTOR_TOS_CREDENTIAL=
XIAOYI_CONNECTOR_TOS_ALLOW_WRITE=false
XIAOYI_CONNECTOR_TOS_HEALTH_PATH=/health
XIAOYI_CONNECTOR_TOS_TIMEOUT_SECONDS=3

# PCS - Port Community System
XIAOYI_CONNECTOR_PCS_MODE=offline
XIAOYI_CONNECTOR_PCS_BASE_URL=
XIAOYI_CONNECTOR_PCS_AUTH_TYPE=none
XIAOYI_CONNECTOR_PCS_CREDENTIAL=
XIAOYI_CONNECTOR_PCS_ALLOW_WRITE=false
XIAOYI_CONNECTOR_PCS_HEALTH_PATH=/health
XIAOYI_CONNECTOR_PCS_TIMEOUT_SECONDS=3

# EMS - Energy Management System
XIAOYI_CONNECTOR_EMS_MODE=offline
XIAOYI_CONNECTOR_EMS_BASE_URL=
XIAOYI_CONNECTOR_EMS_AUTH_TYPE=none
XIAOYI_CONNECTOR_EMS_CREDENTIAL=
XIAOYI_CONNECTOR_EMS_ALLOW_WRITE=false
XIAOYI_CONNECTOR_EMS_HEALTH_PATH=/health
XIAOYI_CONNECTOR_EMS_TIMEOUT_SECONDS=3

# EAM - Enterprise Asset Management
XIAOYI_CONNECTOR_EAM_MODE=offline
XIAOYI_CONNECTOR_EAM_BASE_URL=
XIAOYI_CONNECTOR_EAM_AUTH_TYPE=none
XIAOYI_CONNECTOR_EAM_CREDENTIAL=
XIAOYI_CONNECTOR_EAM_ALLOW_WRITE=false
XIAOYI_CONNECTOR_EAM_HEALTH_PATH=/health
XIAOYI_CONNECTOR_EAM_TIMEOUT_SECONDS=3

# VTS - Vessel Traffic Service
XIAOYI_CONNECTOR_VTS_MODE=offline
XIAOYI_CONNECTOR_VTS_BASE_URL=
XIAOYI_CONNECTOR_VTS_AUTH_TYPE=none
XIAOYI_CONNECTOR_VTS_CREDENTIAL=
XIAOYI_CONNECTOR_VTS_ALLOW_WRITE=false
XIAOYI_CONNECTOR_VTS_HEALTH_PATH=/health
XIAOYI_CONNECTOR_VTS_TIMEOUT_SECONDS=3

# AIS - Automatic Identification System（只读）
XIAOYI_CONNECTOR_AIS_MODE=offline
XIAOYI_CONNECTOR_AIS_BASE_URL=
XIAOYI_CONNECTOR_AIS_AUTH_TYPE=none
XIAOYI_CONNECTOR_AIS_CREDENTIAL=
XIAOYI_CONNECTOR_AIS_ALLOW_WRITE=false
XIAOYI_CONNECTOR_AIS_HEALTH_PATH=/health
XIAOYI_CONNECTOR_AIS_TIMEOUT_SECONDS=3

# METOC - 港区气象与海洋环境服务（连接器 ID: weather，只读）
XIAOYI_CONNECTOR_WEATHER_MODE=offline
XIAOYI_CONNECTOR_WEATHER_BASE_URL=
XIAOYI_CONNECTOR_WEATHER_AUTH_TYPE=none
XIAOYI_CONNECTOR_WEATHER_CREDENTIAL=
XIAOYI_CONNECTOR_WEATHER_ALLOW_WRITE=false
XIAOYI_CONNECTOR_WEATHER_HEALTH_PATH=/health
XIAOYI_CONNECTOR_WEATHER_TIMEOUT_SECONDS=3

# SW - 国际贸易单一窗口（连接器 ID: single-window）
XIAOYI_CONNECTOR_SINGLE_WINDOW_MODE=offline
XIAOYI_CONNECTOR_SINGLE_WINDOW_BASE_URL=
XIAOYI_CONNECTOR_SINGLE_WINDOW_AUTH_TYPE=none
XIAOYI_CONNECTOR_SINGLE_WINDOW_CREDENTIAL=
XIAOYI_CONNECTOR_SINGLE_WINDOW_ALLOW_WRITE=false
XIAOYI_CONNECTOR_SINGLE_WINDOW_HEALTH_PATH=/health
XIAOYI_CONNECTOR_SINGLE_WINDOW_TIMEOUT_SECONDS=3

# -----------------------------------------------------------------------------
# 小懿内部系统能力中枢
# offline：默认不访问其他系统；dry-run仍可检查契约；live：仅允许已登记 GET 只读能力。
# 这些配置不会修改其他系统，且小懿没有跨系统写操作端点。

XIAOYI_SYSTEM_PORT_DT_MODE=offline
XIAOYI_SYSTEM_PORT_DT_BASE_URL=http://127.0.0.1:8000
XIAOYI_SYSTEM_PORT_DT_UI_URL=http://127.0.0.1:8000/

XIAOYI_SYSTEM_ENERGY_COCKPIT_MODE=offline
XIAOYI_SYSTEM_ENERGY_COCKPIT_BASE_URL=http://127.0.0.1:8808
XIAOYI_SYSTEM_ENERGY_COCKPIT_UI_URL=http://127.0.0.1:5173/

XIAOYI_SYSTEM_MALACCA_MODE=offline
XIAOYI_SYSTEM_MALACCA_BASE_URL=http://127.0.0.1:4173
XIAOYI_SYSTEM_MALACCA_UI_URL=http://127.0.0.1:4173/

XIAOYI_SYSTEM_SAILING_MODE=offline
XIAOYI_SYSTEM_SAILING_BASE_URL=
XIAOYI_SYSTEM_SAILING_UI_URL=

# SQLite 持久审计、会话上下文与反馈队列；留空时使用 data/xiaoyi_runtime.db。
XIAOYI_RUNTIME_DB=
