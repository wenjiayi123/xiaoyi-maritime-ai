XIAOYI_APP_NAME=小懿
XIAOYI_MODE=local_rag

# Runtime and security. Never expose local mode to an untrusted network.
XIAOYI_ENV=local
XIAOYI_SECURITY_MODE=local
XIAOYI_ALLOWED_HOSTS=127.0.0.1,localhost
XIAOYI_CORS_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
XIAOYI_DOCS_ENABLED=true
XIAOYI_RATE_LIMIT_REQUESTS=600
XIAOYI_RATE_LIMIT_WINDOW_SECONDS=60
XIAOYI_MAX_REQUEST_BYTES=2500000
XIAOYI_IDEMPOTENCY_TTL_SECONDS=86400
XIAOYI_LOG_LEVEL=INFO

# Required when XIAOYI_SECURITY_MODE=jwt. Keep the secret in a secret manager.
# XIAOYI_JWT_SECRET=<at-least-32-random-bytes>
XIAOYI_JWT_ISSUER=xiaoyi-ai
XIAOYI_JWT_AUDIENCE=xiaoyi-api
XIAOYI_JWT_CLOCK_SKEW_SECONDS=30

# Persistent chat history. SQLite location defaults to data/xiaoyi_runtime.db.
XIAOYI_CHAT_RETENTION_ENABLED=true
XIAOYI_CHAT_RETENTION_DAYS=30
# XIAOYI_RUNTIME_DB=/durable/path/xiaoyi_runtime.db

# Operations data source: operations_sandbox (default) or live.
XIAOYI_PORT_DATA_MODE=operations_sandbox
# Live mode reads a read-only port-ops.v1 integration gateway.
# XIAOYI_PORT_BASE_URL=https://port-integration.example.internal/api
# XIAOYI_PORT_API_TOKEN=<secret-manager-reference>
# XIAOYI_PORT_TIMEOUT_SECONDS=5

# Default local_rules never sends data outside this service.
XIAOYI_MODEL_PROVIDER=local_rules
# XIAOYI_MODEL_BASE_URL=https://approved-model-gateway.example.com/v1
# XIAOYI_MODEL_NAME=<approved-model>
# XIAOYI_MODEL_API_KEY=<secret-manager-reference>
XIAOYI_MODEL_TIMEOUT_SECONDS=30
XIAOYI_MODEL_MAX_RETRIES=2
XIAOYI_MODEL_EXTERNAL_DATA_ALLOWED=false

# Reproducible RL dataset. The bundled public benchmark is used when unset.
# XIAOYI_RL_DATASET_PATH=/absolute/path/to/port_energy.csv
# XIAOYI_RL_DATASET_ID=site-port-energy
# XIAOYI_RL_DATASET_LABEL=某港AGV与站点能源时序
# XIAOYI_RL_DATASET_TIMEZONE=Asia/Shanghai
# XIAOYI_RL_DATASET_MAPPING={"timestamp":"event_time","load_kw":"agv_and_terminal_load_kw","price_per_kwh":"tariff"}
# XIAOYI_RL_ENVIRONMENT_TYPE=port_operations
# XIAOYI_RL_PROFILE_PATH=/absolute/path/to/port_profile.json
# XIAOYI_RL_EVIDENCE_LEVEL=site_measured
# Port operations minimum mapping:
# XIAOYI_RL_DATASET_MAPPING={"timestamp":"event_time","vessel_count":"ais_vessels","anchored_vessels":"anchorage_count","avg_sog_knots":"mean_sog"}

# Optional local launchers. They remain unavailable until explicitly configured.
# XIAOYI_SIMULATOR_ROOT=/path/to/port-dt-multi
# XIAOYI_SIMULATOR_PYTHON=/path/to/port-dt-multi/.venv/bin/python
# XIAOYI_SAILING_SIMULATOR_ROOT=/path/to/godot-project
# XIAOYI_GODOT_BINARY=/path/to/godot
# XIAOYI_ENERGY_ROOT=/path/to/energy-cockpit
# XIAOYI_MALACCA_ROOT=/path/to/malacca-sandbox
